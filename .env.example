# Copy this file to .env for local development.
# For the cloud APK build these two values are stored as GitHub Actions secrets instead.
# Both values are safe to ship inside the app (they are public by design).
# Never put a service_role / secret key here.

# Supabase dashboard -> Project Settings -> API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase dashboard -> Project Settings -> API Keys -> "anon public" key
# (or the "Publishable key" that starts with sb_publishable_ if that is what you see)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
